<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>

  <groupId>dev.filenetmcp</groupId>
  <artifactId>filenet-mcp</artifactId>
  <version>0.1.0</version>
  <name>FileNet 5.7 MCP Server</name>

  <properties>
    <java.version>17</java.version>
    <spring-ai.version>2.0.1</spring-ai.version>
    <!-- Excluded unless built with -Pjace (needs IBM's Jace.jar, which is not on Maven Central). -->
    <jace.exclude>**/jace/**</jace.exclude>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.ai</groupId>
        <artifactId>spring-ai-bom</artifactId>
        <version>${spring-ai.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- MCP server over stdio (default transport) -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-mcp-server</artifactId>
    </dependency>
    <!-- Optional Streamable HTTP transport (profile "http"), secured with HTTP Basic -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <excludes><exclude>${jace.exclude}</exclude></excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- ZIP layout = PropertiesLauncher, so -Dloader.path can add Jace.jar at runtime -->
          <layout>ZIP</layout>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- mvn -Pjace -Djace.jar=/opt/IBM/FileNet/CEClient/lib/Jace.jar package -->
    <profile>
      <id>jace</id>
      <properties><jace.exclude>none</jace.exclude></properties>
      <dependencies>
        <dependency>
          <groupId>com.ibm.filenet</groupId>
          <artifactId>Jace</artifactId>
          <version>5.7</version>
          <scope>system</scope>
          <systemPath>${jace.jar}</systemPath>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
