<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>dev.filenetmcp</groupId>
  <artifactId>filenet-mcp</artifactId>
  <version>0.1.0</version>
  <name>FileNet 5.5 MCP Server</name>

  <properties>
    <java.version>1.8</java.version>
    <!-- Excluded unless built with -Pjace (needs IBM's Jace.jar, which is not on Maven Central). -->
    <jace.exclude>**/jace/**</jace.exclude>
  </properties>

  <dependencies>
    <!-- Needed for the optional Streamable HTTP transport (profile "http") -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <!-- HTTP Basic for the HTTP transport -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <excludes><exclude>${jace.exclude}</exclude></excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- ZIP layout = PropertiesLauncher, so -Dloader.path can add Jace.jar at runtime -->
          <layout>ZIP</layout>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- On JDK 9+ build with release 8 so Java 9+ APIs fail at compile time. (Oracle JDK 8 has no release flag.) -->
    <profile>
      <id>release8</id>
      <activation><jdk>[9,)</jdk></activation>
      <properties><maven.compiler.release>8</maven.compiler.release></properties>
    </profile>
    <!-- mvn -Pjace -Djace.jar=/opt/IBM/FileNet/CEClient/lib/Jace.jar package -->
    <profile>
      <id>jace</id>
      <properties><jace.exclude>none</jace.exclude></properties>
      <dependencies>
        <dependency>
          <groupId>com.ibm.filenet</groupId>
          <artifactId>Jace</artifactId>
          <version>5.5</version>
          <scope>system</scope>
          <systemPath>${jace.jar}</systemPath>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
